# Database Configuration
# For MySQL: mysql+pymysql://user:password@localhost:3306/pizza_delivery_db
# Default Fallback SQLite: sqlite:///./pizza_delivery.db
DATABASE_URL=mysql+pymysql://root:abc123@localhost:3306/pizzahub

# Security & JWT
JWT_SECRET_KEY=pizzahub_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Test Credentials (Optional - Mock fallback enabled if empty)
RAZORPAY_KEY_ID=rzp_test_pizzahub12345
RAZORPAY_KEY_SECRET=pizzahub_razorpay_secret_key_mock

# Email / SMTP Configuration for Notifications & Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@pizzahub.com
SMTP_PASSWORD=app_specific_password_here
SMTP_FROM_EMAIL=noreply@pizzahub.com
ADMIN_EMAIL=admin@pizzahub.com

# System & Frontend URLs
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
